{
  "title": "HelloWorld",
  "description": "A simple schema example with example values",
  "type": "object",
  "properties": {
    "greeting": {
      "type": "string",
      "description": "The greeting message",
      "example": "Hello World!"
    },
    "times": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Number of times to repeat the greeting",
      "example": 3
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Languages in which to say hello",
      "example": ["English", "Spanish", "Italian"]
    },
    "options": {
      "type": "object",
      "description": "Additional options",
      "properties": {
        "shout": {
          "type": "boolean",
          "description": "Whether the greeting should be shouted",
          "example": true
        },
        "punctuation": {
          "type": "string",
          "description": "Punctuation mark to use",
          "example": "!"
        }
      }
    }
  },
  "required": ["greeting"]
}
